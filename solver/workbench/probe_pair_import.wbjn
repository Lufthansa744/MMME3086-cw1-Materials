SetScriptVersion(Version="22.2.192")
import traceback
root=r"C:\Users\A320N\Documents\ChatGPT\MMME3086 cw1\solver"
f=open(root+r"\workbench\pair_import_probe.txt","w")
try:
    s=GetTemplate(TemplateName="Fluid Flow").CreateSystem()
    s.GetContainer(ComponentName="Setup").Import(FileType="CaseAndData",FilePath=root+r"\case01_aligned\case01_aligned_final.cas.h5")
